---
import Image from "@components/atoms/Image/Image.astro";
import type { ImageFormat } from "../../types/config";

interface Props {
	id?: string;
	src: string;
	alt: string;
	position?: "top" | "center" | "bottom";
	widths: number[];
	sizes: string;
	loading: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
	quality: number;
	formats: ImageFormat[];
}

const {
	id,
	src,
	alt,
	position = "center",
	widths,
	sizes,
	loading,
	fetchpriority,
	quality,
	formats,
} = Astro.props as Props;

const videoMatch = src.match(/\.(mp4|webm|ogg)(?:[?#].*)?$/i);
const videoType = videoMatch
	? `video/${videoMatch[1].toLowerCase() === "ogv" ? "ogg" : videoMatch[1].toLowerCase()}`
	: "";
---

{
	videoMatch ? (
		<video
			{id}
			class="block object-cover h-full w-full"
			style={`object-position: ${position}`}
			aria-label={alt}
			muted
			loop
			playsinline
			preload="metadata"
		>
			<source src={src} type={videoType} />
		</video>
	) : (
		<Image
			{id}
			alt={alt}
			class="object-cover h-full w-full"
			src={src}
			position={position}
			widths={widths}
			sizes={sizes}
			loading={loading}
			fetchpriority={fetchpriority}
			quality={quality}
			formats={formats}
		/>
	)
}
